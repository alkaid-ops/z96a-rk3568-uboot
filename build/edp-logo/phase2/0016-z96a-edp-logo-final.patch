+static void rk3568_edp_init_controller(struct rk_edp_priv *priv)
+{
+	struct rk3288_edp *regs = priv->regs;
+	char tag[48];
+
+	/*
+	 * Vendor FUN_00a656ec (RK3568 controller init) writes FUNC_EN_1 =
+	 * 0xbd first.  That mask disables the master video, slave video,
+	 * audio FIFO, audio, HDCP and SW blocks, but explicitly leaves
+	 * VID_CAP_FUNC_EN_N (bit 6) clear.  The RK3568 reset value of that
+	 * bit is 1, so omitting this write leaves the video capture block
