+static int rk_edp_read_timing(struct udevice *dev,
+			      struct display_timing *timing)
+{
+	struct rk_edp_priv *priv = dev_get_priv(dev);
+	ofnode node;
+	int ret;
+
+	ret = panel_get_display_timing(priv->panel, timing);
+	if (!ret)
+		return 0;
+
+	/*
+	 * RAM-test fallback: on this board the live FDT timing decoder can
+	 * return -ENOENT even though the panel node has a complete
+	 * display-timings subnode.  Build the same timing directly from the
+	 * panel DT so the display path can still be validated.
+	 */
+	node = ofnode_path("/panel/display-timings/timing0");
+	if (!ofnode_valid(node))
+		return ret;
+
+#define SET_TIMING(_e, _v) do { \
+	(_e).min = (_e).typ = (_e).max = (_v); \
+} while (0)
+
+	SET_TIMING(timing->pixelclock,
+		   ofnode_read_u32_default(node, "clock-frequency", 0));
+	SET_TIMING(timing->hactive,
+		   ofnode_read_u32_default(node, "hactive", 0));
+	SET_TIMING(timing->hfront_porch,
+		   ofnode_read_u32_default(node, "hfront-porch", 0));
+	SET_TIMING(timing->hsync_len,
+		   ofnode_read_u32_default(node, "hsync-len", 0));
+	SET_TIMING(timing->hback_porch,
+		   ofnode_read_u32_default(node, "hback-porch", 0));
+	SET_TIMING(timing->vactive,
+		   ofnode_read_u32_default(node, "vactive", 0));
+	SET_TIMING(timing->vfront_porch,
+		   ofnode_read_u32_default(node, "vfront-porch", 0));
+	SET_TIMING(timing->vsync_len,
+		   ofnode_read_u32_default(node, "vsync-len", 0));
+	SET_TIMING(timing->vback_porch,
+		   ofnode_read_u32_default(node, "vback-porch", 0));
+
+	timing->flags = 0;
+	if (ofnode_read_u32_default(node, "hsync-active", 1))
+		timing->flags |= DISPLAY_FLAGS_HSYNC_HIGH;
+	else
+		timing->flags |= DISPLAY_FLAGS_HSYNC_LOW;
+	if (ofnode_read_u32_default(node, "vsync-active", 0))
+		timing->flags |= DISPLAY_FLAGS_VSYNC_HIGH;
+	else
+		timing->flags |= DISPLAY_FLAGS_VSYNC_LOW;
+	if (ofnode_read_u32_default(node, "de-active", 1))
+		timing->flags |= DISPLAY_FLAGS_DE_HIGH;
+	else
+		timing->flags |= DISPLAY_FLAGS_DE_LOW;
+	if (ofnode_read_u32_default(node, "pixelclk-active", 0))
+		timing->flags |= DISPLAY_FLAGS_PIXDATA_POSEDGE;
+	else
+		timing->flags |= DISPLAY_FLAGS_PIXDATA_NEGEDGE;
+
+#undef SET_TIMING
+
+	if (!timing->pixelclock.typ || !timing->hactive.typ ||
+	    !timing->vactive.typ)
+		return ret;
+
+	z96a_diag_edp_fallback = 1;
+
+	return 0;
+}
+
 static const struct dm_display_ops dp_rockchip_ops = {
 	.read_edid = rk_edp_read_edid,
+	.read_timing = rk_edp_read_timing,
 	.enable = rk_edp_enable,
 };
 
