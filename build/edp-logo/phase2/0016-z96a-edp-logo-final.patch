--- a/arch/arm/dts/rk3568-z96a-laptop-v2-u-boot.dtsi
+++ b/arch/arm/dts/rk3568-z96a-laptop-v2-u-boot.dtsi
@@ -23,3 +23,12 @@
 &vcca_1v8 {
 	bootph-all;
 };
+
+/*
+ * The SoC rk356x-u-boot.dtsi sets max-frequency = <200000000> on the eMMC
+ * controller after the board DTS.  Override it here: this board's eMMC is
+ * only reliable at 50MHz (HS400 writes fail; HS200/50MHz is stable).
+ */
+&sdhci {
+	max-frequency = <50000000>;
+};
