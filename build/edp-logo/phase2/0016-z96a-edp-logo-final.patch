+
+DECLARE_GLOBAL_DATA_PTR;
+
+/* Temporary RAM-test diagnostics, defined in z96a_rk3568/board.c */
+extern int z96a_diag_vop_stage;
+extern int z96a_diag_vop_ret;
+extern int z96a_diag_vop_port;
+extern int z96a_diag_vop_win_id;
+extern int z96a_diag_vop_layer;
+extern int z96a_diag_vop_esmart;
+extern void z96a_marker(const char *tag);
+
+#define VOP_DIAG(stage, err) do { \
+	if ((stage) > z96a_diag_vop_stage) { \
+		z96a_diag_vop_stage = (stage); \
+		z96a_diag_vop_ret = (err); \
+		z96a_diag_vop_port = port_id; \
+	} \
+} while (0)
+
+enum vop_pol {
+	HSYNC_POSITIVE = 0,
+	VSYNC_POSITIVE = 1,
+	DEN_NEGATIVE   = 2,
+	DCLK_INVERT    = 3
+};
+
+static void rkvop2_cfg_regdone(struct rk3568_vop_sysctrl *sysctrl, int port)
+{
+	u32 reg;
+
+	reg = M_GLOBAL_REGDONE;
+
+	/*
+	 * For RK3588, changes will only take effect when the same bit is
+	 * leftshifted by 16.
+	 */
+	reg |= M_LOAD_GLOBAL(port) | M_LOAD_GLOBAL(port) << 16;
+
+	writel(reg, &sysctrl->reg_cfg_done);
+}
+
+static int rkvop2_enable(struct udevice *dev, ulong fbbase,
+			 int fb_bits_per_pixel, const struct display_timing *edid,
+			 int port, int win_id, struct rkvop2_platdata *platdata)
+{
+	struct rk_vop2_priv *priv = dev_get_priv(dev);
+	struct rk3568_vop_overlay *overlay = priv->regs + VOP2_OVERLAY_OFFSET;
+	struct rk3568_vop_esmart *esmart;
+	int esmart_idx = -1;
+	bool is_cluster = false;
+	u8 layer;
+	u32 reg;
+	u32 rgb_mode;
+	u32 hactive = edid->hactive.typ;
+	u32 vactive = edid->vactive.typ;
+
+	if (win_id < 0 || win_id > 9)
+		return -EINVAL;
+
+	/*
+	 * win_id is the RK3568 hardware layer ID (0..9).  The platdata
+	 * layers[] table is not reliable across the RK3566/RK3568 enum
+	 * aliases, so use the hardware ID directly.
+	 */
+	layer = win_id;
+
+	/*
+	 * RK3568 layer IDs: Cluster0/1=0/1, Esmart0/1=2/3, Smart0/1=4/5,
+	 * Cluster2/3=6/7, Esmart2/3=8/9.  Only the ESMART windows are
+	 * implemented here; SMART planes are not supported.
+	 */
+	switch (layer) {
+	case 0:
+	case 1:
+	case 6:
+	case 7:
+		is_cluster = true;
+		break;
+	case 2:
+	case 3:
+		esmart_idx = layer - 2;
+		break;
+	case 8:
+	case 9:
+		esmart_idx = layer - 6;
+		break;
+	default:
+		dev_err(dev, "layer %d is not an ESMART window\n", layer);
+		return -ENOSYS;
+	}
+
+	z96a_diag_vop_win_id = win_id;
+	z96a_diag_vop_layer = layer;
+	z96a_diag_vop_esmart = esmart_idx;
+
+	debug("(%s, %s): win_id = %d - layer = %d - esmart = %d - cluster: %d\n",
+	      dev_read_name(dev), __func__, win_id, layer, esmart_idx,
+	      is_cluster);
+
+	/* TODO: Support VOP2 CLUSTER */
+	if (is_cluster) {
+		dev_err(dev, "win_id is a cluster, not supported.\n");
+		return -ENOSYS;
+	}
+
+	esmart = priv->regs + VOP2_ESMART_OFFSET(esmart_idx);
+
+	debug("(%s, %s): esmart addr: 0x%p\n", dev_read_name(dev), __func__, esmart);
+
+	writel(V_ACT_WIDTH(hactive - 1) | V_ACT_HEIGHT(vactive - 1),
+	       &esmart->esmart_region0_act_info);
+
+	/* Set offset to 0,0 */
+	writel(0, &esmart->esmart_region0_dsp_offset);
+
+	writel(V_DSP_WIDTH(hactive - 1) |
+			V_DSP_HEIGHT(vactive - 1),
+			&esmart->esmart_region0_dsp_info);
+
+	switch (fb_bits_per_pixel) {
+	case 16:
+		rgb_mode = RGB565;
+		writel(V_RGB565_VIRWIDTH(hactive), &esmart->esmart_region0_vir);
+		break;
+	case 24:
+		rgb_mode = RGB888;
+		writel(V_RGB888_VIRWIDTH(hactive), &esmart->esmart_region0_vir);
+		break;
+	case 32:
+	default:
+		rgb_mode = ARGB8888;
+		writel(V_ARGB888_VIRWIDTH(hactive), &esmart->esmart_region0_vir);
+		break;
+	}
+
+	writel(fbbase, &esmart->esmart_region0_mst_yrgb);
+
+	priv->esmart_mst_ctl = V_ESMART_REGION0_DATA_FMT(rgb_mode) |
+			       M_ESMART_REGION0_MST_EN;
+	/* Defer MST_EN until after the eDP video stream is configured. */
+	writel(V_ESMART_REGION0_DATA_FMT(rgb_mode),
+	       &esmart->esmart_region0_mst_ctl);
+
+	/* Set esmart to the destination video port */
+	reg = V_ESMART_SEL_PORT(esmart_idx, port);
+
+	/*
+	 * VOP2 requires every port mux to be configured.
+	 *
+	 * As U-Boot only supports singledisplay, we'll set all
+	 * unused ports to set layer to 8 (disabled).
+	 */
+	for (int i = 0; i < 4; i++) {
+		if (i != port)
+			reg |= V_PORT_MUX(8, i);
+	}
+
+	writel(reg, &overlay->port_sel);
+
+	/* Set layer 0 to win_id */
+	writel(V_LAYER_SEL(0, win_id), &overlay->layer_sel);
+
+	reg = readl(&overlay->overlay_ctrl) | M_LAYER_SEL_REGDONE_EN;
+	writel(reg, &overlay->overlay_ctrl);
+
+	priv->layer = layer;
+
+	return 0;
+}
+
+void rk_vop2_disable(struct udevice *dev)
+{
+	struct rk_vop2_priv *priv = dev_get_priv(dev);
+	struct rk3568_vop_sysctrl *sysctrl = priv->regs + VOP2_SYSREG_OFFSET;
+	struct rk3568_vop_esmart *esmart;
+	struct rk3568_vop_post *post;
+	int esmart_idx = -1;
+
+	/*
+	 * If the plane was enabled but link training or panel enable failed,
+	 * leave the VOP2 plane disabled before handing over to Linux/Linux's
+	 * VOP2 driver.  Otherwise the ESMART keeps scanning the framebuffer
+	 * and the Linux VOP2 IOMMU attach can fail.
+	 */
+	switch (priv->layer) {
+	case 2:
+	case 3:
+		esmart_idx = priv->layer - 2;
+		break;
+	case 8:
+	case 9:
+		esmart_idx = priv->layer - 6;
+		break;
+	default:
+		break;
+	}
+	if (esmart_idx >= 0) {
+		esmart = priv->regs + VOP2_ESMART_OFFSET(esmart_idx);
+		writel(0, &esmart->esmart_region0_mst_ctl);
+	}
+
+	if (priv->vp >= 0) {
+		post = priv->regs + VOP2_POST_OFFSET(priv->vp);
+		clrbits_le32(&post->color_ctrl, M_POST_COLORBAR_EN);
+		clrsetbits_le32(&post->dsp_ctrl, M_POST_STANDBY,
+				V_POST_STANDBY(1));
+		rkvop2_cfg_regdone(sysctrl, priv->vp);
+	}
+}
+
+/* RAM-test only: distinguish VP output from plane/framebuffer scanout. */
+void z96a_vop_test_colorbar(struct udevice *dev)
+{
+	struct rk_vop2_priv *priv = dev_get_priv(dev);
+	struct rk3568_vop_post *post;
+	struct rk3568_vop_sysctrl *sysctrl;
+
+	if (priv->vp < 0)
+		return;
+	post = priv->regs + VOP2_POST_OFFSET(priv->vp);
+	sysctrl = priv->regs + VOP2_SYSREG_OFFSET;
+	setbits_le32(&post->color_ctrl, M_POST_COLORBAR_EN);
+	rkvop2_cfg_regdone(sysctrl, priv->vp);
+}
+
+/* RAM-test only: turn the post color bar off again. */
+void z96a_vop_test_colorbar_off(struct udevice *dev)
+{
+	struct rk_vop2_priv *priv = dev_get_priv(dev);
+	struct rk3568_vop_post *post;
+	struct rk3568_vop_sysctrl *sysctrl;
+
+	if (priv->vp < 0)
+		return;
+	post = priv->regs + VOP2_POST_OFFSET(priv->vp);
+	sysctrl = priv->regs + VOP2_SYSREG_OFFSET;
+	clrbits_le32(&post->color_ctrl, M_POST_COLORBAR_EN);
+	rkvop2_cfg_regdone(sysctrl, priv->vp);
+}
+
+static void rkvop2_set_pin_polarity(struct udevice *dev,
+				    enum vop_modes mode, u32 polarity)
+{
+	struct rkvop2_driverdata *ops =
+		(struct rkvop2_driverdata *)dev_get_driver_data(dev);
+
+	if (ops->set_pin_polarity)
+		ops->set_pin_polarity(dev, mode, polarity);
+}
+
+static void rkvop2_enable_output(struct udevice *dev, enum vop_modes mode, u32 port)
+{
+	struct rkvop2_driverdata *ops =
+		(struct rkvop2_driverdata *)dev_get_driver_data(dev);
+
+	if (ops->enable_output)
+		ops->enable_output(dev, mode, port);
+}
+
+/*
+ * The eDP driver calls this after link training and before configuring the
+ * eDP video stream.  The VOP output must be running so that the eDP
+ * controller sees the video stream clock, but it must not be enabled before
+ * link training or the VOP/memory bus hangs on RK3568.
+ */
+static struct udevice *z96a_edp_vop_dev;
+static int z96a_edp_vop_port;
+static u32 z96a_edp_vop_polarity;
+
+void z96a_vop_output_on(void)
+{
+	struct rk_vop2_priv *priv;
+	struct rk3568_vop_esmart *esmart;
+	struct rk3568_vop_sysctrl *sysctrl;
+	struct rk3568_vop_post *post;
+	char tag[96];
+
+	if (!z96a_edp_vop_dev)
+		return;
+
+	priv = dev_get_priv(z96a_edp_vop_dev);
+	esmart = priv->regs + VOP2_ESMART_OFFSET(0);
+	sysctrl = priv->regs + VOP2_SYSREG_OFFSET;
+	post = priv->regs + VOP2_POST_OFFSET(priv->vp);
+
+	/* Keep the plane disabled while the output interface starts. */
+	writel(0, &esmart->esmart_region0_mst_ctl);
+
+	z96a_marker("dsp_en_zero");
+	writel(0, &((struct rk3568_vop_sysctrl *)
+		    (priv->regs + VOP2_SYSREG_OFFSET))->dsp_en);
+	z96a_marker("dsp_en_zero_done");
+
+	z96a_marker("dsp_en_edp_only");
+	writel(BIT(3), &((struct rk3568_vop_sysctrl *)
+			(priv->regs + VOP2_SYSREG_OFFSET))->dsp_en);
+	z96a_marker("dsp_en_edp_only_done");
+
+	z96a_marker("vop_output_enable");
+	rkvop2_enable_output(z96a_edp_vop_dev, VOP_MODE_EDP,
+			     z96a_edp_vop_port);
+	z96a_marker("vop_output_enabled");
+	z96a_marker("vop_pol_enable");
+	rkvop2_set_pin_polarity(z96a_edp_vop_dev, VOP_MODE_EDP,
+				z96a_edp_vop_polarity);
+	z96a_marker("vop_pol_enabled");
+
+	snprintf(tag, sizeof(tag), "vopout_en_%x_pol_%x_vpctrl_%x",
+		 readl(&sysctrl->dsp_en), readl(&sysctrl->dsp_pol),
+		 readl(&post->dsp_ctrl));
+	z96a_marker(tag);
+}
+
+void z96a_vop_plane_on(void)
+{
+	struct rk_vop2_priv *priv;
+	struct rk3568_vop_esmart *esmart;
+	struct rk3568_vop_sysctrl *sysctrl;
+
+	if (!z96a_edp_vop_dev)
+		return;
+
+	priv = dev_get_priv(z96a_edp_vop_dev);
+	esmart = priv->regs + VOP2_ESMART_OFFSET(0);
+	sysctrl = priv->regs + VOP2_SYSREG_OFFSET;
+	writel(priv->esmart_mst_ctl, &esmart->esmart_region0_mst_ctl);
+	rkvop2_cfg_regdone(sysctrl, priv->vp);
+}
+
+static void rkvop2_mode_set(struct udevice *dev,
+			    const struct display_timing *edid,
+		enum vop_modes mode, int port,
+		struct rkvop2_platdata *platdata)
+{
+	struct rk_vop2_priv *priv = dev_get_priv(dev);
+	struct rk3568_vop_sysctrl *sysctrl = priv->regs + VOP2_SYSREG_OFFSET;
+	struct rk3568_vop_post *post = priv->regs + VOP2_POST_OFFSET(port);
+	struct rkvop2_driverdata *data =
+		(struct rkvop2_driverdata *)dev_get_driver_data(dev);
+
+	debug("(%s, %s): port addr: 0x%p\n", dev_read_name(dev), __func__, post);
+
+	u32 hactive = edid->hactive.typ;
+	u32 vactive = edid->vactive.typ;
+	u32 hsync_len = edid->hsync_len.typ;
+	u32 hback_porch = edid->hback_porch.typ;
+	u32 vsync_len = edid->vsync_len.typ;
+	u32 vback_porch = edid->vback_porch.typ;
+	u32 hfront_porch = edid->hfront_porch.typ;
+	u32 vfront_porch = edid->vfront_porch.typ;
+	int mode_flags;
+	u32 reg;
+
+	z96a_marker("ms_entry");
+	/*
+	 * Do NOT touch the dsp_pol/dsp_en output registers here.  On RK3568
+	 * they must only be programmed after the eDP link training and video
+	 * configuration have completed; doing it earlier hangs the VOP.
+	 */
+
+	/*
+	 * Live mainline Linux on this exact board drives the same eDP panel
+	 * with VP1 DSP_CTRL out_mode = 0 (P888/RGB888) while the eDP
+	 * controller runs 8 bpc (VIDEO_CTL_2 = 0x10).  The vendor 2017
+	 * U-Boot uses AAAA here, but the working Linux state is the better
+	 * reference for this hardware; a 32-bit AAAA bus into an 8-bpc RGB
+	 * input would misalign the pixel data while leaving sync intact.
+	 */
+	mode_flags = 0;  /* RGB888 */
+	if (mode == VOP_MODE_DP)
+		mode_flags = 15;  /* AAAA */
+	else if ((data->features & VOP_FEATURE_OUTPUT_10BIT) &&
+		 mode == VOP_MODE_HDMI)
+		mode_flags = 15;  /* RGBaaa */
+
+	reg = V_DSP_OUT_MODE(mode_flags);
+
+	debug("(%s, %s): bg_dly: %d\n",
+	      dev_read_name(dev), __func__, platdata->bg_dly[port]);
+
+	if (platdata->bg_dly[port] < 0) {
+		dev_err(dev, "bg_dly is zero for vp%d\n", port);
+		return;
+	}
+
+	writel(((platdata->bg_dly[port] + (hactive >> 1) - 1) << 16) | hsync_len,
+	       &post->prescan_htimings);
+	z96a_marker("ms_prescan");
+
+	writel(V_HSYNC(hsync_len) |
+			V_HORPRD(hsync_len + hback_porch + hactive + hfront_porch),
+			&post->dsp_htotal_hs_end);
+	z96a_marker("ms_htotal");
+
+	writel(V_HEAP(hsync_len + hback_porch + hactive) |
+			V_HASP(hsync_len + hback_porch),
+			&post->dsp_hact_st_end);
+	z96a_marker("ms_hact_st");
+
+	writel(V_VAEP(vsync_len + vback_porch + vactive) |
+			V_VASP(vsync_len + vback_porch),
+			&post->dsp_vact_st_end);
+	z96a_marker("ms_vact_st");
+
+	writel(V_VSYNC(vsync_len) |
+			V_VERPRD(vsync_len + vback_porch + vactive + vfront_porch),
+			&post->dsp_vtotal_vs_end);
+	z96a_marker("ms_vtotal");
+
+	writel(V_HEAP(hsync_len + hback_porch + hactive) |
+			V_HASP(hsync_len + hback_porch),
+			&post->dsp_hact_info);
+	z96a_marker("ms_hact_info");
+
+	writel(V_VAEP(vsync_len + vback_porch + vactive) |
+			V_VASP(vsync_len + vback_porch),
+			&post->dsp_vact_info);
+	z96a_marker("ms_vact_info");
+
+	/* No scaling */
+	writel(0x10001000, &post->scl_factor_yrgb);
+	z96a_marker("ms_scl");
+
+	writel(reg, &post->dsp_ctrl);
+	z96a_marker("ms_ctrl");
+
+	rkvop2_cfg_regdone(sysctrl, port);
+	z96a_marker("ms_done");
+}
+
+/**
+ * rk_display_init() - Try to enable the given display device
+ *
+ * This function performs many steps:
+ * - Finds the display device being referenced by @ep_node
+ * - Puts the VOP's ID into its uclass platform data
+ * - Probes the device to set it up
+ * - Reads the timing information (from EDID or panel)
+ * - Sets up the VOP clocks, etc. for the selected pixel clock and display mode
+ * - Enables the display (the display device handles this and will do different
+ *     things depending on the display type)
+ * - Tells the uclass about the display resolution so that the console will
+ *     appear correctly
+ *
+ * @dev:	VOP device that we want to connect to the display
+ * @fbbase:	Frame buffer address
+ * @vp_node:	Device tree node to process
+ * Return: 0 if OK, -ve if something went wrong
+ */
+static int rk_display_init(struct udevice *dev, ulong fbbase, ofnode vp_node)
+{
+	struct rk_vop2_priv *priv = dev_get_priv(dev);
+	struct video_priv *uc_priv = dev_get_uclass_priv(dev);
+	struct rkvop2_driverdata *drvdata =
+		(struct rkvop2_driverdata *)dev_get_driver_data(dev);
+	struct rkvop2_platdata *platdata =
+		(struct rkvop2_platdata *)drvdata->platdata;
+	ofnode ep_node;
+	int vop_id, port_id, win_id;
+	struct display_timing timing;
+	struct udevice *disp;
+	int ret;
+	u32 remote_phandle;
+	u32 pin_polarity;
+	struct display_plat *disp_uc_plat;
+	enum video_log2_bpp l2bpp;
+	ofnode remote;
+	const char *compat;
+	char dclk_name[9];
+	struct clk dclk;
+
+	debug("%s(%s, 0x%lx, %s)\n", __func__,
+	      dev_read_name(dev), fbbase, ofnode_get_name(vp_node));
+
+	port_id = ofnode_read_u32_default(vp_node, "reg", -1);
+	if (port_id < 0) {
+		debug("%s(%s): no video port id\n", __func__, dev_read_name(dev));
+		VOP_DIAG(1, port_id);
+		return port_id;
+	}
+	VOP_DIAG(1, 0);
+
+	ep_node = ofnode_first_subnode(vp_node);
+	if (!ofnode_valid(ep_node)) {
+		debug("%s(%s): no valid subnode\n", __func__, dev_read_name(dev));
+		VOP_DIAG(2, -EINVAL);
+		return -EINVAL;
+	}
+	VOP_DIAG(2, 0);
+
+	ret = ofnode_read_u32(ep_node, "remote-endpoint", &remote_phandle);
+	if (ret) {
+		debug("%s(%s): no remote-endpoint\n", __func__, dev_read_name(dev));
+		VOP_DIAG(3, ret);
+		return ret;
+	}
+	VOP_DIAG(3, 0);
+
+	remote = ofnode_get_by_phandle(remote_phandle);
+	if (!ofnode_valid(remote)) {
+		VOP_DIAG(4, -EINVAL);
+		return -EINVAL;
+	}
+	VOP_DIAG(4, 0);
+
+	remote = ofnode_get_parent(remote);
+	if (!ofnode_valid(remote)) {
+		VOP_DIAG(5, -EINVAL);
+		return -EINVAL;
+	}
+	VOP_DIAG(5, 0);
+
+	/*
+	 * The remote-endpoint references into a subnode of the encoder
+	 * (i.e. HDMI, MIPI, etc.) with the DTS looking something like
+	 * the following:
+	 *
+	 * hdmi: hdmi@fe0a0000 {
+	 *   ports {
+	 *     hdmi_in: port {
+	 *       hdmi_in_vp0: endpoint { ... };
+	 *     }
+	 *   }
+	 * }
+	 *
+	 * This isn't any different from how VOP1 works, so we'll adapt
+	 * the same method of finding the display from the original code
+	 * (find the enclosing device of "UCLASS_DISPLAY")
+	 *
+	 * We also look for UCLASS_VIDEO_BRIDGE so we can use the existing
+	 * DW MIPI DSI driver for Rockchip.
+	 */
+	while (ofnode_valid(remote)) {
+		remote = ofnode_get_parent(remote);
+		if (!ofnode_valid(remote)) {
+			debug("%s(%s): no UCLASS_DISPLAY for remote-endpoint\n",
+			      __func__, dev_read_name(dev));
+			VOP_DIAG(6, -EINVAL);
+			return -EINVAL;
+		}
+
+		uclass_find_device_by_ofnode(UCLASS_DISPLAY, remote, &disp);
+		if (disp)
+			break;
+	};
+	if (!disp) {
+		VOP_DIAG(6, -EINVAL);
+		return -EINVAL;
+	}
+	VOP_DIAG(6, 0);
+
+	compat = ofnode_get_property(remote, "compatible", NULL);
+	if (!compat) {
+		debug("%s(%s): Failed to find compatible property\n",
+		      __func__, dev_read_name(dev));
+		VOP_DIAG(7, -EINVAL);
+		return -EINVAL;
+	}
+	VOP_DIAG(7, 0);
+	if (strstr(compat, "edp")) {
+		vop_id = VOP_MODE_EDP;
+	} else if (strstr(compat, "mipi")) {
+		vop_id = VOP_MODE_MIPI;
+	} else if (strstr(compat, "hdmi")) {
+		vop_id = VOP_MODE_HDMI;
+	} else if (strstr(compat, "rk3588-dp")) {
+		vop_id = VOP_MODE_DP;
+	} else if (strstr(compat, "lvds")) {
+		vop_id = VOP_MODE_LVDS;
+	} else {
+		debug("%s(%s): Failed to find vop mode for %s\n",
+		      __func__, dev_read_name(dev), compat);
+		VOP_DIAG(8, -EINVAL);
+		return -EINVAL;
+	}
+	debug("vop_id=%d - port=%d\n", vop_id, port_id);
+	VOP_DIAG(8, 0);
+
+	/* Get the video port clock and enable it */
+	snprintf(dclk_name, sizeof(dclk_name), "dclk_vp%d", port_id);
+	ret = clk_get_by_name(dev, dclk_name, &dclk);
+	if (ret < 0) {
+		VOP_DIAG(9, ret);
+		return ret;
+	}
+	VOP_DIAG(9, 0);
+
+	disp_uc_plat = dev_get_uclass_plat(disp);
+	debug("Found device '%s', disp_uc_priv=%p\n", disp->name, disp_uc_plat);
+	if (display_in_use(disp)) {
+		debug("   - device in use\n");
+		VOP_DIAG(10, -EBUSY);
+		return -EBUSY;
+	}
+	VOP_DIAG(10, 0);
+
+	disp_uc_plat->source_id = vop_id;
+	disp_uc_plat->src_dev = dev;
+
+	ret = device_probe(disp);
+	if (ret) {
+		debug("%s: device '%s' display won't probe (ret=%d)\n",
+		      __func__, dev->name, ret);
+		VOP_DIAG(11, ret);
+		return ret;
+	}
+	VOP_DIAG(11, 0);
+
+	ret = display_read_timing(disp, &timing);
+	if (ret) {
+		debug("%s: Failed to read timings\n", __func__);
+		VOP_DIAG(12, ret);
+		return ret;
+	}
+	VOP_DIAG(12, 0);
+
+	/* Set clock rate on video port to display timings */
+	ret = clk_set_rate(&dclk, timing.pixelclock.typ);
+	if (ret < 0) {
+		dev_err(dev, "Failed to set clock rate: %d\n", ret);
+		VOP_DIAG(13, ret);
+		return ret;
+	}
+	z96a_marker("dclk_set");
+	ret = clk_enable(&dclk);
+	if (ret && ret != -ENOSYS) {
+		dev_err(dev, "Failed to enable dclk: %d\n", ret);
+		VOP_DIAG(13, ret);
+		return ret;
+	}
+	z96a_marker("dclk_enabled");
+	VOP_DIAG(13, 0);
+
+	{
+		struct rk3568_cru *cru = rockchip_get_cru();
+		char tag[64];
+
+		if (cru) {
+			/* Read-only observation: the CRU gate uses a write mask. */
+			snprintf(tag, sizeof(tag), "dclk_gate_%x_sel_%x",
+				 readl(&cru->clkgate_con[20]),
+				 readl(&cru->clksel_con[40]));
+			z96a_marker(tag);
+		}
+	}
+
+	debug("%s(%s): %s clkrate %lu\n", __func__, dev_read_name(dev),
+	      dclk_name, clk_get_rate(&dclk));
+
+	/* Set bitwidth for vop display according to vop mode */
+	switch (vop_id) {
+	case VOP_MODE_EDP:
+	case VOP_MODE_MIPI:
+	case VOP_MODE_HDMI:
+	case VOP_MODE_DP:
+	case VOP_MODE_LVDS:
+		l2bpp = VIDEO_BPP32;
+		break;
+	default:
+		l2bpp = VIDEO_BPP16;
+	}
+
+	/*
+	 * We'll use the default platform-specific win_id from Linux
+	 * so that Linux can take over U-Boot plane when Linux reconfigures
+	 * VOP2.
+	 */
+	win_id = platdata->vp_lyr[port_id];
+	/*
+	 * eDP is wired to VP1 and the U-Boot driver only implements
+	 * ESMART windows.  Use ESMART0 (RK3568 hardware layer 2)
+	 * explicitly; do not trust the ambiguous platdata table.
+	 */
+	if (vop_id == VOP_MODE_EDP && port_id == 1)
+		win_id = 2;
+	if (win_id < 0) {
+		dev_err(dev, "win_id is null, don't setup\n");
+		VOP_DIAG(14, -EINVAL);
+		return -EINVAL;
+	}
+	VOP_DIAG(14, 0);
+	if (platdata->bg_dly[port_id] < 0) {
+		dev_err(dev, "bg_dly is not set for vp%d\n", port_id);
+		VOP_DIAG(15, -EINVAL);
+		return -EINVAL;
+	}
+	VOP_DIAG(15, 0);
+
+	priv->vp = port_id;
+
+	z96a_marker("vop_enable");
+	ret = rkvop2_enable(dev, fbbase, 1 << l2bpp, &timing, port_id, win_id, platdata);
+	if (ret < 0) {
+		z96a_marker("vop_enable_fail");
+		VOP_DIAG(16, ret);
+		return ret;
+	}
+	VOP_DIAG(16, 0);
+	z96a_marker("vop_enabled");
+
+	rkvop2_mode_set(dev, &timing, vop_id, port_id, platdata);
+
+	/*
+	 * Live mainline Linux on this board reports EDP_POL = 0x1 for this
+	 * panel: hsync positive, vsync negative, DE positive and no DCLK
+	 * inversion.  Keep the inherited default inversion for the other
+	 * interfaces, but match the working Linux value for eDP.
+	 */
+	pin_polarity = (vop_id == VOP_MODE_EDP) ? 0 : BIT(DCLK_INVERT);
+	if (timing.flags & DISPLAY_FLAGS_PIXDATA_POSEDGE)
+		pin_polarity &= ~BIT(DCLK_INVERT);
+	if (timing.flags & DISPLAY_FLAGS_HSYNC_HIGH)
+		pin_polarity |= BIT(HSYNC_POSITIVE);
+	if (timing.flags & DISPLAY_FLAGS_VSYNC_HIGH)
+		pin_polarity |= BIT(VSYNC_POSITIVE);
+
+	z96a_edp_vop_dev = dev;
+	z96a_edp_vop_port = port_id;
+	z96a_edp_vop_polarity = pin_polarity;
+
+	z96a_marker("edp_enable");
+	ret = display_enable(disp, 1 << l2bpp, &timing);
+	if (ret) {
+		z96a_marker("edp_enable_fail");
+		VOP_DIAG(17, ret);
+		z96a_edp_vop_dev = NULL;
+		rk_vop2_disable(dev);
+		return ret;
+	}
+	VOP_DIAG(17, 0);
+	z96a_marker("edp_enabled");
+
+	uc_priv->xsize = timing.hactive.typ;
+	uc_priv->ysize = timing.vactive.typ;
+	uc_priv->bpix = l2bpp;
+
+	debug("fb=%lx, size=%d %d\n", fbbase,
+	      uc_priv->xsize, uc_priv->ysize);
+	VOP_DIAG(18, 0);
+
+	return 0;
+}
+
+int rk_vop2_probe(struct udevice *dev)
+{
+	struct video_uc_plat *plat = dev_get_uclass_plat(dev);
+	struct rk_vop2_priv *priv = dev_get_priv(dev);
+	int ret = 0;
+	ofnode port, node;
+
+	/* Before relocation we don't need to do anything */
+	if (!(gd->flags & GD_FLG_RELOC))
+		return 0;
+
+	if (IS_ENABLED(CONFIG_EFI_LOADER)) {
+		debug("Adding to EFI map %d @ %lx\n", plat->size, plat->base);
+		efi_add_memory_map(plat->base, plat->size, EFI_RESERVED_MEMORY_TYPE);
+	}
+
+	priv->regs = dev_read_addr_ptr(dev);
+	priv->vp = -1;
+	priv->layer = -1;
+
+	/* Try all the ports until we find one that works. */
+	port = dev_read_subnode(dev, "ports");
+	if (!ofnode_valid(port)) {
+		debug("%s(%s): 'port' subnode not found\n",
+		      __func__, dev_read_name(dev));
+		return -EINVAL;
+	}
+
+	for (node = ofnode_first_subnode(port);
+			ofnode_valid(node);
+			node = dev_read_next_subnode(node)) {
+		ret = rk_display_init(dev, plat->base, node);
+		if (ret)
+			debug("Device failed: ret=%d\n", ret);
+		if (!ret)
+			break;
+	}
+	video_set_flush_dcache(dev, true);
+
+	return ret;
+}
+
+int rk_vop2_bind(struct udevice *dev)
+{
+	struct video_uc_plat *plat = dev_get_uclass_plat(dev);
+
+	plat->size = 4 * (CONFIG_VIDEO_ROCKCHIP_MAX_XRES *
+			CONFIG_VIDEO_ROCKCHIP_MAX_YRES);
+
+	return 0;
+}
diff --git a/drivers/video/rockchip/rk_vop2.h b/drivers/video/rockchip/rk_vop2.h
new file mode 100644
index 0000000000..a96b5ba2f2
--- /dev/null
+++ b/drivers/video/rockchip/rk_vop2.h
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Copyright (c) 2017 Theobroma Systems Design und Consulting GmbH
+ */
+
+#ifndef __RK_VOP2_H__
+#define __RK_VOP2_H__
+
+#include <asm/arch-rockchip/vop_rk3568.h>
+
+struct rk_vop2_priv {
+	void *grf;
+	void *regs;
+	int vp;
+	int layer;
+	u32 esmart_mst_ctl;
+};
+
+enum vop2_features {
+	VOP_FEATURE_OUTPUT_10BIT = (1 << 0),
+};
+
+enum vop2_layer {
+	ROCKCHIP_VOP2_CLUSTER0 = 0,
+	ROCKCHIP_VOP2_CLUSTER1,
+	ROCKCHIP_VOP2_CLUSTER2,
+	ROCKCHIP_VOP2_CLUSTER3,
+	ROCKCHIP_VOP2_ESMART0,
+	ROCKCHIP_VOP2_ESMART1,
+	ROCKCHIP_VOP2_ESMART2,
+	ROCKCHIP_VOP2_ESMART3,
+	ROCKCHIP_VOP2_SMART0 = 6,
+	ROCKCHIP_VOP2_SMART1,
+	ROCKCHIP_VOP2_RESERVED = -1,
+};
+
+struct rkvop2_platdata {
+	const u8 delay;
+	const s8 bg_dly[4]; /* VOP2 supports up to 4 video ports (0-3) */
+	const s8 vp_lyr[4];
+	const s8 layers[8];
+};
+
+struct rkvop2_driverdata {
+	/* configuration */
+	u32 features;
+	void *platdata;
+	/* block-specific setters/getters */
+	void (*enable_output)(struct udevice *dev, enum vop_modes mode, u32 port);
+	void (*set_pin_polarity)(struct udevice *dev, enum vop_modes mode, u32 port);
+};
+
+/**
+ * rk_vop2_probe() - common probe implementation
+ *
+ * Performs the rk_display_init on each port-subnode until finding a
+ * working port (or returning an error if none of the ports could be
+ * successfully initialised).
+ *
+ * @dev:	device
+ * Return: 0 if OK, -ve if something went wrong
+ */
+int rk_vop2_probe(struct udevice *dev);
+void rk_vop2_disable(struct udevice *dev);
+
+/**
+ * rk_vop2_bind() - common bind implementation
+ *
+ * Sets the plat->size field to the amount of memory to be reserved for
+ * the framebuffer: this is always
+ *     (32 BPP) x VIDEO_ROCKCHIP_MAX_XRES x VIDEO_ROCKCHIP_MAX_YRES
+ *
+ * @dev:	device
+ * Return: 0 (always OK)
+ */
+int rk_vop2_bind(struct udevice *dev);
+
+#endif
