+static int rk3568_edp_probe(struct udevice *dev, struct rk_edp_priv *priv)
+{
+	struct reset_ctl dp_rst, apb_rst;
+	int ret;
+
+	EDP_DIAG(3, 0);
+
+	/*
+	 * Panel power was enabled by the simple-panel probe.  100ms is far
+	 * beyond the panel power-up requirement and keeps the vendor's
+	 * original 200ms guard off the critical logo path.
+	 */
+	mdelay(100);
+
+	ret = reset_get_by_name(dev, "dp", &dp_rst);
+	if (ret) {
+		dev_err(dev, "failed to get eDP reset (ret=%d)\n", ret);
+		EDP_DIAG(4, ret);
+		return ret;
+	}
+	EDP_DIAG(4, 0);
+
+	reset_assert(&dp_rst);
+	udelay(20);
+	reset_deassert(&dp_rst);
+	EDP_DIAG(5, 0);
+
+	ret = reset_get_by_name(dev, "apb", &apb_rst);
+	if (!ret) {
+		reset_assert(&apb_rst);
+		udelay(20);
+		reset_deassert(&apb_rst);
+	}
+	EDP_DIAG(6, 0);
+
+	rk3568_edp_ungate_clocks();
+	EDP_DIAG(7, 0);
+
+	ret = generic_phy_get_by_name(dev, "dp", &priv->phy);
+	if (ret) {
+		dev_err(dev, "failed to get eDP PHY (ret=%d)\n", ret);
+		EDP_DIAG(8, ret);
+		return ret;
+	}
+	EDP_DIAG(8, 0);
+
+	ret = generic_phy_set_mode(&priv->phy, PHY_MODE_DP, 0);
+	if (ret) {
+		EDP_DIAG(9, ret);
+		return ret;
+	}
+	EDP_DIAG(9, 0);
+
+	ret = generic_phy_power_on(&priv->phy);
+	if (ret) {
+		dev_err(dev, "failed to power on eDP PHY (ret=%d)\n", ret);
+		EDP_DIAG(10, ret);
+		return ret;
+	}
+	EDP_DIAG(10, 0);
+
+	rockchip_edp_force_hpd(priv);
+	EDP_DIAG(11, 0);
+
+	rk3568_edp_init_controller(priv);
+	EDP_DIAG(12, 0);
+
+	return 0;
+}
