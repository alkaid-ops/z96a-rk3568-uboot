diff --git a/include/phy-dp.h b/include/phy-dp.h
new file mode 100644
index 0000000000..371e939fc8
--- /dev/null
+++ b/include/phy-dp.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * DisplayPort/eDP PHY configuration options.
+ *
+ * U-Boot's generic PHY API passes an opaque pointer to .configure().  This
+ * structure is the eDP-specific payload used by the RK3568 Naneng eDP PHY
+ * and the RK3568 eDP controller.
+ */
+
+#ifndef __PHY_DP_H__
+#define __PHY_DP_H__
+
+#include <linux/types.h>
+
+struct phy_configure_opts_dp {
+	/* Link rate in 100 Mbps units: 1620 = 1.62 Gbps, 2700 = 2.7 Gbps */
+	u32 link_rate;
+	/* Number of lanes: 1, 2 or 4 */
+	u32 lanes;
+	/* Per-lane voltage swing and pre-emphasis levels (0..3) */
+	u8 voltage[4];
+	u8 pre[4];
+	bool set_rate;
+	bool set_lanes;
+	bool set_voltages;
+	bool ssc;
+};
+
+#endif /* __PHY_DP_H__ */
