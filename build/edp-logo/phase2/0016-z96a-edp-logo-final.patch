+++ b/board/rockchip/z96a_rk3568/Kconfig
@@ -9,4 +9,23 @@ config SYS_VENDOR
 config SYS_CONFIG_NAME
 	default "z96a_rk3568"
 
+config Z96A_EDP_LOGO
+	bool "Enable the Z96A eDP logo path"
+	default n
+	help
+	  Allow the z96a_logo command to bind and probe the disabled VOP2
+	  node and show a logo on the internal eDP panel.  When disabled the
+	  command is a no-op and the display stack is never probed.
+
+config Z96A_DISPLAY_DIAG
+	bool "Enable RAM-test display diagnostics"
+	default n
+	depends on Z96A_EDP_LOGO
+	help
+	  Compile in the temporary RAM-test instrumentation: FAT stage
+	  markers, the three-phase visual observation window, the VOP post
+	  color bar and the eDP video BIST hook.  In production this must
+	  stay disabled so a display-enabled boot does not write to USB,
+	  blink the power LED for ten seconds or draw test patterns.
+
 endif
