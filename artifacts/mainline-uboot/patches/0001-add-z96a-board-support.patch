@@ -0,0 +1,7 @@
+# SPDX-License-Identifier: GPL-2.0+
+#
+# Sunniwell Z96A RK3568 Laptop V2 - own board directory
+# (kept separate from board/rockchip/evb_rk3568/ so z96a-specific
+# late-init code does not affect the generic RK3568 EVB target)
