+/*
+ * eDP / VOP2 logo path.
+ *
+ * The VOP2 node stays disabled in the live DT.  z96a-logo binds it manually
+ * after the USB-only scan has returned, so a USB boot never probes the
+ * display controllers.
+ */
+&edp_phy {
+	status = "okay";
+};
+
+&edp {
+	status = "okay";
+	force-hpd;
+	rockchip,panel = <&panel>;
+};
+
+&edp_in {
+	edp_in_vp1: endpoint {
+		remote-endpoint = <&vp1_out_edp>;
+	};
+};
+
+&vp1 {
+	vp1_out_edp: endpoint@3 {
+		reg = <ROCKCHIP_VOP2_EP_EDP0>;
+		remote-endpoint = <&edp_in_vp1>;
+	};
+};
+
+&pwm9 {
+	status = "okay";
+};
+
+&vop {
+	status = "disabled";
+
+	assigned-clocks = <&cru DCLK_VOP1>, <&cru PLL_VPLL>;
+	assigned-clock-rates = <139800000>, <699000000>;
+	assigned-clock-parents = <&cru PLL_VPLL>;
+};
