+/*
+ * RK3568 uses an external Naneng eDP PHY.  The Analogix controller still
+ * has the standard analog register block, but its initialisation values
+ * differ from RK3288/RK3399.  Follow the Linux analogix_dp_reg.c sequence
+ * instead of the old RK3288 internal-PHY values.
+ */
+#define RK3568_ANALOG_CTL_1		0x370
+#define RK3568_ANALOG_CTL_3		0x378
+#define RK3568_PLL_FILTER_CTL_1		0x37c
+#define RK3568_TX_AMP_TUNING_CTL	0x380
+#define RK3568_AUX_HW_RETRY_CTL		0x390
+#define RK3568_TX_DVDD_BIT_1_0625V	(0x4 << 0)
+
+static void rk3568_edp_ungate_clocks(void)
+{
+	struct rk3568_cru *cru = rockchip_get_cru();
+	struct rk3568_pmucru *pmucru = rockchip_get_pmucru();
+
+	if (cru) {
+		/* CLK_EDP_200M source: gpll_200m (200 MHz). */
+		rk_clrsetreg(&cru->clksel_con[38], GENMASK(9, 8), 0);
+		/* PCLK_EDP_CTRL, CLK_EDP_200M, PCLK_EDPPHY_GRF. */
+		rk_clrreg(&cru->clkgate_con[21], BIT(8) | BIT(9));
+		rk_clrreg(&cru->clkgate_con[34], BIT(14));
+	}
+
+	if (pmucru)
+		/* XIN_OSC0_EDPPHY_G. */
+		rk_clrreg(&pmucru->pmu_clkgate_con[2], BIT(15));
+}
+
+static void rk3568_edp_init_analog_param(struct rk3288_edp *regs)
+{
+	writel(TX_TERMINAL_CTRL_50_OHM,
+	       (u8 *)regs + RK3568_ANALOG_CTL_1);
+	writel(SEL_24M | RK3568_TX_DVDD_BIT_1_0625V, &regs->analog_ctl_2);
+
+	writel(REF_CLK_24M, &regs->pll_reg_1);
+	writel(0x95, &regs->pll_reg_2);
+	writel(0x40, &regs->pll_reg_3);
+	writel(0x58, &regs->pll_reg_4);
+	writel(0x22, &regs->pll_reg_5);
+
+	writel(DRIVE_DVDD_BIT_1_0625V | VCO_BIT_600_MICRO,
+	       (u8 *)regs + RK3568_ANALOG_CTL_3);
+	writel(PD_RING_OSC | AUX_TERMINAL_CTRL_50_OHM |
+	       TX_CUR1_2X | TX_CUR_16_MA,
+	       (u8 *)regs + RK3568_PLL_FILTER_CTL_1);
+	writel(0, (u8 *)regs + RK3568_TX_AMP_TUNING_CTL);
+}
+
+static void rk3568_edp_init_interrupt(struct rk3288_edp *regs)
+{
+	writel(INT_POL, &regs->int_ctl);
+
+	writel(0xff, &regs->common_int_sta_1);
+	writel(0x4f, &regs->common_int_sta_2);
+	writel(0xe0, &regs->common_int_sta_3);
+	writel(0xe7, &regs->common_int_sta_4);
+	writel(0x63, &regs->dp_int_sta);
+
+	writel(0x00, &regs->common_int_mask_1);
+	writel(0x00, &regs->common_int_mask_2);
+	writel(0x00, &regs->common_int_mask_3);
+	writel(0x00, &regs->common_int_mask_4);
+	writel(0x00, &regs->int_sta_mask);
+}
+
+static void rk3568_edp_init_analog_func(struct rk3288_edp *regs)
+{
+	u32 reg;
+
+	/* POWER_ALL off: the Linux Analogix sequence for Rockchip IP. */
+	writel(0xff, &regs->dp_pd);
+	udelay(10);
+	writel(0x7f, &regs->dp_pd);
+	udelay(10);
+	writel(0x00, &regs->dp_pd);
+
+	writel(PLL_LOCK_CHG, &regs->common_int_sta_1);
+	reg = readl(&regs->dp_debug_ctl);
+	reg &= ~(F_PLL_LOCK | PLL_LOCK_CTRL);
+	writel(reg, &regs->dp_debug_ctl);
+
+	/* PLL power up. */
+	reg = readl(&regs->dp_pd);
+	reg &= ~PD_PLL;
+	writel(reg, &regs->dp_pd);
+
+	/* Enable Serdes FIFO, link-symbol clock and AUX. */
+	reg = readl(&regs->func_en_2);
+	reg &= ~(SERDES_FIFO_FUNC_EN_N | LS_CLK_DOMAIN_FUNC_EN_N |
+		 AUX_FUNC_EN_N);
+	writel(reg, &regs->func_en_2);
+}
+
+static void rk3568_edp_init_aux(struct rk3288_edp *regs)
+{
+	u32 reg;
+
+	writel(RPLY_RECEIV | AUX_ERR, &regs->dp_int_sta);
+
+	/* AUX block power cycle, as in Linux analogix_dp_init_aux(). */
+	reg = readl(&regs->dp_pd);
+	reg |= PD_AUX;
+	writel(reg, &regs->dp_pd);
+	udelay(10);
+	reg &= ~PD_AUX;
+	writel(reg, &regs->dp_pd);
+
+	/* Disable AUX channel, then re-enable it. */
+	setbits_le32(&regs->func_en_2, AUX_FUNC_EN_N);
+
+	writel(0, (u8 *)regs + RK3568_AUX_HW_RETRY_CTL);
+	writel(DEFER_CTRL_EN | DEFER_COUNT(1), &regs->aux_ch_defer_dtl);
+
+	clrbits_le32(&regs->func_en_2, AUX_FUNC_EN_N);
+}
+
+static void rk3568_edp_init_controller(struct rk_edp_priv *priv)
+{
+	struct rk3288_edp *regs = priv->regs;
+
+	rk3568_edp_init_analog_param(regs);
+	rk3568_edp_init_interrupt(regs);
+
+	/* SW-defined function normal operation. */
+	clrbits_le32(&regs->func_en_1, SW_FUNC_EN_N);
+
+	rk3568_edp_init_analog_func(regs);
+	rk3568_edp_init_aux(regs);
+
+	/* 6 bpc, RGB, VESA range -- matches the BOE NV140FHM-N43 panel. */
+	writel(IN_D_RANGE_VESA | IN_BPC_6_BITS | IN_COLOR_F_RGB,
+	       &regs->video_ctl_2);
+}
+
+static int rk3568_edp_probe(struct udevice *dev, struct rk_edp_priv *priv)
+{
+	struct reset_ctl dp_rst, apb_rst;
+	int ret;
+
+	/* Panel power was enabled by the simple-panel probe. */
+	mdelay(200);
+
+	ret = reset_get_by_name(dev, "dp", &dp_rst);
+	if (ret) {
+		dev_err(dev, "failed to get eDP reset (ret=%d)\n", ret);
+		return ret;
+	}
+
+	reset_assert(&dp_rst);
+	udelay(20);
+	reset_deassert(&dp_rst);
+
+	ret = reset_get_by_name(dev, "apb", &apb_rst);
+	if (!ret) {
+		reset_assert(&apb_rst);
+		udelay(20);
+		reset_deassert(&apb_rst);
+	}
+
+	rk3568_edp_ungate_clocks();
+
+	ret = generic_phy_get_by_name(dev, "dp", &priv->phy);
+	if (ret) {
+		dev_err(dev, "failed to get eDP PHY (ret=%d)\n", ret);
+		return ret;
+	}
+
+	ret = generic_phy_set_mode(&priv->phy, PHY_MODE_DP, 0);
+	if (ret)
+		return ret;
+
+	ret = generic_phy_power_on(&priv->phy);
+	if (ret) {
+		dev_err(dev, "failed to power on eDP PHY (ret=%d)\n", ret);
+		return ret;
+	}
+
+	rockchip_edp_force_hpd(priv);
+	rk3568_edp_init_controller(priv);
+
+	return 0;
+}
