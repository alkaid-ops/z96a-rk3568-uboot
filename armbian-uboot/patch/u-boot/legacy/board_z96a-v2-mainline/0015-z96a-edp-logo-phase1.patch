+#define EDP_PHY_TX2_AMP_SCALE		GENMASK(5, 4)
+#define EDP_PHY_TX1_AMP_SCALE		GENMASK(3, 2)
+#define EDP_PHY_TX0_AMP_SCALE		GENMASK(1, 0)
+#define EDP_PHY_GRF_CON6		0x0018
