+	/*
+	 * Front-panel LEDs (same wiring as the Linux DTS).  U-Boot drives
+	 * them from board_late_init so the user gets immediate feedback
+	 * instead of waiting for the Linux charger/LED drivers.
+	 */
+	leds {
+		compatible = "gpio-leds";
+		bootph-all;
+
+		led-power {
+			label = "z96a-led-power";
+			gpios = <&gpio0 RK_PD3 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+			bootph-all;
+		};
+
+		led-charging {
+			label = "z96a-led-charging";
+			gpios = <&gpio0 RK_PD5 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+			bootph-all;
+		};
+
+		led-full {
+			label = "z96a-led-full";
+			gpios = <&gpio0 RK_PD6 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+			bootph-all;
+		};
+	};
+
