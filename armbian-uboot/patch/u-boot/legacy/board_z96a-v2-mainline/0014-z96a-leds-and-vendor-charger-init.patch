+static void z96a_led_set(const char *label, bool on)
+{
+	struct udevice *dev;
+
+	if (led_get_by_label(label, &dev))
+		return;
+	led_set_state(dev, on ? LEDST_ON : LEDST_OFF);
+}
+
+/* power = white (charger online), charging = red, full = green */
+static void z96a_leds_update(bool ac, bool charging, bool full)
+{
+	z96a_led_set("z96a-led-power", ac);
+	z96a_led_set("z96a-led-charging", ac && charging);
+	z96a_led_set("z96a-led-full", ac && !charging && full);
+}
+
+static void z96a_leds_immediate(void)
+{
+	z96a_led_set("z96a-led-power", true);
+	z96a_led_set("z96a-led-charging", false);
+	z96a_led_set("z96a-led-full", false);
+}
