# Large binaries / build products (never commit)
/artifacts/**/*.bin
/artifacts/**/*.dtb
/artifacts/**/*.elf
/artifacts/**/*.img
/artifacts/**/*.itb
/artifacts/**/*.deb
/artifacts/**/*.gz
/artifacts/**/*.zip
/artifacts/**/*.xz
/artifacts/**/*.log

/build/**/*.bin
/build/**/*.dtb
/build/**/*.elf
/build/**/*.img
/build/**/*.itb
/build/**/*.deb
/build/**/*.gz
/build/**/*.zip
/build/**/*.xz
/build/**/*.log
/build/atf/
/build/out/host-tools/
/build/out/*/u-boot*
/build/out/*/idbloader*
/build/out/*/z96a_chainload*
/build/backup-*/
/build/vendor-v1/u-boot-patched.bin
/build/vendor-v1/vendor-idbloader.bin
/build/vendor-v1/vendor-p2-uboot.bin
/build/vendor-v1/*.tar.gz
/build/out/*/*.bin

# Armbian build sandbox caches/output and generic (large) trees
/armbian-uboot/cache/
/armbian-uboot/output/
/armbian-uboot/.tmp/
/armbian-uboot/build/
/armbian-uboot/.ccache/
/armbian-uboot/logs/
/armbian-uboot/patch/kernel/archive/
/armbian-uboot/patch/misc/
/armbian-uboot/packages/
/armbian-uboot/lib/
/armbian-uboot/tools/
/armbian-uboot/extensions/

# Nested source trees / tool clones
/rea-src/
/u-boot-mainline-src/
/ghidra-projects/
/node_modules/
/.cache/

# General
*.o
*.a
*.ko
*.so
*.pyc
__pycache__/
.DS_Store
